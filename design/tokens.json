  "rules": [
    "Square ruled frame, round things inside.",
    "Tangerine = Wessel made/did it; grape = you can touch it. Never swap.",
    "Only Wessel and the bots select. One pin visible at a time.",
    "Night (purple hour) overrides the system theme after sunset (Amsterdam).",
    "No new colours, sizes or styles without Wons."
  ],
  "tactile": {
    "$description": "Tactile objects (2026-10-27): things you can press, plus pins, tags and key chips, get a lit top edge and a short drop tinted in their own colour. Marks stay flat. Per mode: lit = top-edge white alpha on fills, litOutline = on canvas-coloured objects, drop = how much of the object's colour goes into its shadow. outline = resting drop for canvas-coloured pressables; key = keycap edges. dropDark = how far the tinted drop is pulled toward black (dark/night, so light pills don't look lit).",
    "light": {
      "lit": {
        "$value": 0.32
      },
      "litOutline": {
        "$value": 0.6
      },
      "drop": {
        "$value": "55%"
      },
      "outline": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.6), 0 1px 2px rgb(0 0 0 / 0.06), 0 4px 10px -6px rgb(0 0 0 / 0.18)"
      },
      "key": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.2), inset 0 -2px 0 rgb(0 0 0 / 0.45), 0 1px 2px rgb(0 0 0 / 0.2)"
      },
      "dropDark": {
        "$value": "0%"
      }
    },
    "dark": {
      "lit": {
        "$value": 0.2
      },
      "litOutline": {
        "$value": 0.06
      },
      "drop": {
        "$value": "45%"
      },
      "outline": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.06), 0 4px 10px -6px rgb(0 0 0 / 0.5)"
      },
      "key": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.8), inset 0 -2px 0 rgb(0 0 0 / 0.18), 0 1px 2px rgb(0 0 0 / 0.4)"
      },
      "dropDark": {
        "$value": "70%"
      }
    },
    "night": {
      "lit": {
        "$value": 0.07
      },
      "litOutline": {
        "$value": 0.05
      },
      "drop": {
        "$value": "30%"
      },
      "outline": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.05), 0 4px 10px -6px rgb(0 0 0 / 0.5)"
      },
      "key": {
        "$value": "inset 0 1px 0 rgb(255 255 255 / 0.8), inset 0 -2px 0 rgb(0 0 0 / 0.18), 0 1px 2px rgb(0 0 0 / 0.4)"
      },
      "dropDark": {
        "$value": "70%"
      }
    }
  }
