# Public, safe to commit. Defaults live in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=u0p6z6ze
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Secret. Put it in .env.local and in Vercel's environment variables, never in git.
# Viewer token from sanity.io/manage > API > Tokens. Needed for drafts and click-to-edit.
SANITY_API_READ_TOKEN=

# Secret. Signs Sanity's publish webhook (sanity.io/manage > API > Webhooks,
# POST https://wesseloud.cv/api/revalidate), so published edits refresh the site.
SANITY_REVALIDATE_SECRET=
